{
  "rules": [
    {
      "id": "blk-compromised-contract",
      "event_abis": {
        "transfer": {
          "type": "event",
          "name": "Transfer",
          "inputs": [
            { "name": "from", "type": "address", "indexed": true },
            { "name": "to", "type": "address", "indexed": true },
            { "name": "value", "type": "uint256", "indexed": false }
          ],
          "anonymous": false
        }
      },
      "condition": {
        "in": [
          { "var": "transfer.from" },
          [
            "0x000000000000000000000000000000000bad0001",
            "0x000000000000000000000000000000000bad0002"
          ]
        ]
      },
      "action": "deny"
    },
    {
      "id": "deny-deposit-without-matching-transfer",
      "contract_address": "0x00000000000000000000000000000000000bad00",
      "event_abis": {
        "deposit": {
          "type": "event",
          "name": "Deposit",
          "inputs": [
            { "name": "from", "type": "address", "indexed": true },
            { "name": "token", "type": "address", "indexed": true },
            { "name": "amount", "type": "uint256", "indexed": false }
          ],
          "anonymous": false
        },
        "transfer": {
          "type": "event",
          "name": "Transfer",
          "inputs": [
            { "name": "from", "type": "address", "indexed": true },
            { "name": "to", "type": "address", "indexed": true },
            { "name": "value", "type": "uint256", "indexed": false }
          ],
          "anonymous": false
        }
      },
      "condition": {
        "or": [
          { "!=": [{ "var": "transfer.to" }, "0x00000000000000000000000000000000000bad00"] },
          { "!=": [{ "var": "deposit.amount" }, { "var": "transfer.value" }] }
        ]
      },
      "action": "deny"
    },
    {
      "id": "blk-asset-owner-update-unauthorized-origin",
      "contract_address": "0x00000000000000000000000000000000000bad00",
      "event_abis": {
        "asset_owner_updated": {
          "type": "event",
          "name": "AssetOwnerUpdated",
          "inputs": [
            { "name": "assetId", "type": "bytes32", "indexed": true },
            { "name": "newOwner", "type": "address", "indexed": true }
          ],
          "anonymous": false
        }
      },
      "condition": {
        "!=": [{ "var": "origin" }, "0x000000000000000000000000000000000a0000d1"]
      },
      "action": "deny"
    },
    {
      "id": "deny-proxy-delegatecall-to-unapproved-implementation",
      "event_abis": {},
      "callstack": {
        "direct_delegatecalls": {
          "vaultProxy": "0x00000000000000000000000000000000000ab001"
        }
      },
      "condition": {
        "!": {
          "in": [
            { "var": "vaultProxy.delegateCodeHash" },
            [
              "0x1111111111111111111111111111111111111111111111111111111111111111",
              "0x2222222222222222222222222222222222222222222222222222222222222222"
            ]
          ]
        }
      },
      "action": "deny"
    },
    {
      "id": "deny-router-delegatecall-to-unapproved-implementation",
      "event_abis": {},
      "callstack": {
        "direct_delegatecalls": {
          "routerProxy": "0x00000000000000000000000000000000000ab002"
        }
      },
      "condition": {
        "!": {
          "in": [
            { "var": "routerProxy.delegateCodeHash" },
            ["0x3333333333333333333333333333333333333333333333333333333333333333"]
          ]
        }
      },
      "action": "deny"
    },
    {
      "id": "deny-paired-implementation-address-and-code-hash",
      "event_abis": {},
      "callstack": {
        "direct_delegatecalls": {
          "bridgeProxy": "0x00000000000000000000000000000000000ab003"
        }
      },
      "condition": {
        "!": {
          "or": [
            {
              "and": [
                { "==": [{ "var": "bridgeProxy.delegateTo" }, "0x00000000000000000000000000000000000c0de1"] },
                { "==": [{ "var": "bridgeProxy.delegateCodeHash" }, "0x4444444444444444444444444444444444444444444444444444444444444444"] }
              ]
            },
            {
              "and": [
                { "==": [{ "var": "bridgeProxy.delegateTo" }, "0x00000000000000000000000000000000000c0de2"] },
                { "==": [{ "var": "bridgeProxy.delegateCodeHash" }, "0x5555555555555555555555555555555555555555555555555555555555555555"] }
              ]
            }
          ]
        }
      },
      "action": "deny"
    },
    {
      "id": "schema-compatibility-mixed-event-and-direct-delegatecall-audit",
      "event_abis": {
        "transfer": {
          "type": "event",
          "name": "Transfer",
          "inputs": [
            { "name": "from", "type": "address", "indexed": true },
            { "name": "to", "type": "address", "indexed": true },
            { "name": "value", "type": "uint256", "indexed": false }
          ],
          "anonymous": false
        }
      },
      "callstack": {
        "direct_delegatecalls": {
          "vaultProxy": "0x00000000000000000000000000000000000ab001"
        }
      },
      "condition": {
        "and": [
          { "in": [{ "var": "transfer.from" }, ["0x00000000000000000000000000000000000bad00"]] },
          {
            "!": {
              "in": [
                { "var": "vaultProxy.delegateCodeHash" },
                ["0x1111111111111111111111111111111111111111111111111111111111111111"]
              ]
            }
          }
        ]
      },
      "action": "audit",
      "audit_types": ["delegatecall_review"]
    }
  ]
}
