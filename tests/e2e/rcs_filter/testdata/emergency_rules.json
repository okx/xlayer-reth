{
  "protocol_version": 1,
  "content_version": 2,
  "rules": [
    {
      "id": "emergency-deny-all",
      "event_abis": {
        "transfer": {
          "type": "event",
          "name": "Transfer",
          "inputs": [
            { "name": "from", "type": "address", "indexed": true },
            { "name": "to", "type": "address", "indexed": true },
            { "name": "value", "type": "uint256", "indexed": false }
          ],
          "anonymous": false
        }
      },
      "condition": { "!=": [ { "var": "contract_address" }, "0xb1ac000000000000000000000000000000000001" ] },
      "action": "deny"
    }
  ]
}
